  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fuga de Margarida de Anjou was painted by Francisco Vieira Portuense during
    the period he spent living in London. It was presented at an exhibition at the
    Royal Academy of Arts in 1798 and was inspired by David Hume's History of England,
    published between 1754 and 1762. The episode depicted took place during the War
    of the Roses (1455\u20131485), in which the opposing Lancaster and York families
    entered into a dispute over the throne of England. The scene represents the moment
    when Queen Margaret of Anjou escaped to Scotland with her son Edward. This is
    perhaps the most moving moment of the whole story, heightened here by the positioning
    of the figures at the mercy of a monumental landscape."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
