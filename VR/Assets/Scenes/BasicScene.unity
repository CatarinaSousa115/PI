  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A C\xE2mara Clara \xE9 um instrumento \xF3tico, auxiliar do desenho. Atrav\xE9s
    de um sistema de espelho e lentes, projeta no papel o objeto observado. Contornando
    essa imagem, obt\xE9m-se um desenho mais preciso e rigoroso.\r\nEsta pe\xE7a
    foi oferecida por D. Pedro ao mestre de Desenho Jo\xE3o Baptista Ribeiro, como
    refere a inscri\xE7\xE3o na tampa: D. Pedro, Duque de Bragan\xE7a na cidade do
    Porto deo a Jo\xE3o Baptista Ribeiro em 1833.\r\n\r\n1806\u20131833\r\nLat\xE3o
    e vidro, estojo, mogno, veludo e fio dourado\r\nBrass and glass; mahogany, velvet
    and gilt thread\r\nDep\xF3sito C\xE2mara Municipal do Porto / antigo MMP\r\nDeposit
    Porto City Council / former MMP\r\n55 Obj Hist CMP / MNSR"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
