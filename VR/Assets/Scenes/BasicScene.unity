  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "These artists were prominent in Portugal at the dawn of the 19th century,
    creating innovative works on historical themes in the period and society heralding
    Romanticism, the cultural movement sweeping through Europe at the time. They
    were in close contact with the most illustrious European art scenes and were
    court painters for King Jo\xE3o VI.\r\n\r\nSequeira (1768\u20131837) left a vast
    oeuvre that illustrates the cultural and political and social transformations
    of the early 19th century, such as his depiction of the French Invasions in Junot
    protegendo a cidade de Lisboa (Junot protecting the city of Lisbon). The landscape
    showing the Escape of Fuga de Margarida de Anjou (The Escape of Margaret of Anjou)
    by Vieira Portuense (1765\u20131805) reflects the emphasis on sentiment that
    heralded the romantic era."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
