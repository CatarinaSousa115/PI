  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O n\xFAcleo inicial da cole\xE7\xE3o do Museu \xE9 composto sobretudo
    por obras de Pintura e Gravura retiradas em 1833 dos mosteiros, hosp\xEDcios
    e conventos abandonados do Porto. Com a promulga\xE7\xE3o do decreto de extin\xE7\xE3o
    das ordens religiosas em 1834 procedeu-se \xE0 integra\xE7\xE3o no Museu dos
    bens art\xEDsticos dos mosteiros de S. Martinho de Tib\xE3es e de Santa Cruz
    de Coimbra.\r\n\r\nEste primeiro museu p\xFAblico de arte do pa\xEDs inventariou
    pinturas, gravuras e objetos hist\xF3ricos, como a s\xE9rie de esmaltes da Paix\xE3o
    de Cristo do Mosteiro de Santa Cruz de Coimbra.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
