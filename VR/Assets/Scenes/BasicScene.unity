  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'This is an allegoric composition of the political alliance between the
    Iberian nations, Portugal and Spain, and Great Britain in reaction to the invasion
    of Napoleonic troops. Based on historical events of the time, it is thought to
    have been painted between 1808 and 1813.

    The young men hold their swords
    together in a gesture of united forces, while a winged spirit hovers above, a
    protective figure that watches over the Iberian people. The figure to the left,
    completing the composition, is Minerva, the goddess who engineers strategies
    of war.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
