--- !u!114 &1460247899
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1460247897}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\nThe Escape of Margaret of Anjou\r\n\r\nA Fuga de Margarida de Anjou
    foi pintada por Francisco Vieira Portuense no per\xEDodo em que viveu em Londres.
    Foi apresentada na exposi\xE7\xE3o da Royal Academy of Arts em 1798 e \xE9 inspirada
    na Hist\xF3ria de Inglaterra de David Hume, publicada entre 1754 e 1762. O epis\xF3dio
    retratado ocorreu durante a Guerra das Duas Rosas (1455\u20131485) que op\xF4s
    as fam\xEDlias de Lancaster e York na disputa pelo trono de Inglaterra. A cena
    representa um momento da fuga da rainha Margarida de Anjou com o filho Eduardo
    para a Esc\xF3cia. Este \xE9 talvez o momento mais emotivo de todo o epis\xF3dio,
    refor\xE7ado aqui pelo posicionamento das figuras \xE0 merc\xEA de uma paisagem
    monumental.\n\n\r\n\r\nFrancisco Vieira (o Portuense) (1765\u20131805)\r\n1798\r\n\xD3leo
    sobre tela\r\nOil on canvas\r\nDep\xF3sito C\xE2mara Municipal do Porto /\r\nCole\xE7\xE3o
    Allen \u2013 antigo MMP\r\nDeposit Porto City Council /\r\nAllen Collection \u2013
    former MMP\r\n23 Pin CMP / MNSR"
  m_isRightToLeft: 0
