  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\n\r\nO Museu Nacional Soares dos Reis tem origem no Museu de Pinturas
    e Estampas e outros objetos de Belas Artes, criado por D. Pedro IV de Portugal,
    primeiro Imperador do Brasil. Conhecido como Museu Portuense, ficou instalado
    no extinto Convento de Santo Ant\xF3nio da Cidade, na pra\xE7a de S\xE3o L\xE1zaro.\r\n\r\nFoi
    durante a guerra civil entre liberais e absolutistas (1832\u201334) que D. Pedro
    mandou o pintor Jo\xE3o Batista Ribeiro recolher obras de arte dos partid\xE1rios
    do seu advers\xE1rio D. Miguel e pertencentes aos conventos abandonados do Porto
    \u2014 n\xFAcleo que deu in\xEDcio \xE0 cole\xE7\xE3o do Museu."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
