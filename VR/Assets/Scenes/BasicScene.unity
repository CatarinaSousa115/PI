  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nesta vitrina s\xE3o expostos, em rotatividade, elementos dos uniformes
    utilizados por D. Pedro durante a guerra civil, da qual o Cerco do Porto (julho
    de 1832 \u2013 agosto 1833) foi o per\xEDodo mais sangrento. Por este valor simb\xF3lico,
    o museu guarda a Espada, Jaqueta, Colete, Bon\xE9 \u2014 entregues \xE0 cidade
    do Porto pela sua filha D. Maria II \u2014 bem como Chap\xE9u armado, Talabarte,
    Porta-mapas e Bin\xF3culo doados pela sua vi\xFAva D. Am\xE9lia, ao Museu Portuense.\r\n\r\nDo
    uniforme do Regimento de Ca\xE7adores n\xBA 5\r\nMilitary uniform of Regimento
    de Ca\xE7adores n\xBA 5\r\nc. 1832\r\nA\xE7o polido e cromado, chagrin (pele
    de ca\xE7\xE3o, no punho), couro, metal dourado, fio met\xE1lico dourado\r\nPolished
    and chromed steel, dogfish skin on the handle), leather, gilt metal, gilt metal
    thread trimmings\r\nDep\xF3sito C\xE2mara Municipal do Porto / antigo MMP\r\nDeposit
    Porto City Council / former MMP\r\n28 Obj Hist CMP / MNSR"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
