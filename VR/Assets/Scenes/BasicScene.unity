  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "S\xE9rie de vinte e seis placas com cenas do Ciclo da Paix\xE3o de Cristo\r\nSeries
    of 26 plaques with scenes of the Cycle of the Passion of Christ\r\n\r\nO esmalte
    pintado sobre cobre \xE9 uma arte do fogo, que se desenvolveu particularmente
    na segunda metade do s\xE9culo XVI, em Fran\xE7a, na regi\xE3o de Limoges. A\xED
    se estabeleceram numerosas oficinas de esmaltador \u2014 entre as quais aquela
    que \xE9 atualmente designada pelo nome de conven\xE7\xE3o Oficina da Pequena
    Paix\xE3o de Santa Cruz de Coimbra \u2014 cuja produ\xE7\xE3o, muito ao gosto
    das elites desse tempo, se difundiu por toda a Europa.\n\nAn\xF3nimo, Oficina
    da Pequena Paix\xE3o de Santa Cruz de Coimbra (at.)\r\nAnonymous, Small Passion
    of Santa Cruz de Coimbra Workshop (at.)\r\nLimoges, 1570\u20131599\r\nEsmalte
    pintado sobre cobre\r\nPainted enamel on copper\r\nMosteiro de Santa Cruz de
    Coimbra\r\n\u2013 Fundo Antigo\r\nMonastery of Santa Cruz de Coimbra\r\n\u2013
    Special Collections\r\n2.1 a 2.26 Div MNSR"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
