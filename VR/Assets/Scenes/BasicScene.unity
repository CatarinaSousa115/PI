  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Retrato do Visconde de Pernes\r\nPortrait of the Viscount of Pernes\r\n\r\nRetrato
    da Viscondessa de Pernes\r\nPortrait of the Viscountess of Pernes\r\n\r\nPedro
    Paulo Ferreira de Sousa, 1\xBA bar\xE3o de Pernes e bravo combatente da Batalha
    de Pernes de 1834, e a sua esposa, a baronesa, Helena de \xC1gueda Bon.\r\nMiguel
    \xC2ngelo Lupi, retratista da sociedade burguesa entre 1870 e 1880, \xE9 considerado
    o percursor do realismo no retrato em Portugal. O artista destaca as duas personalidades
    representando-as sobre fundos trabalhados em esquemas de grada\xE7\xE3o de cor,
    conferindo ilus\xE3o de profundidade.\r\nO casal \xE9 retratado onze anos ap\xF3s
    a morte do bar\xE3o, o que ter\xE1 obrigado o artista a recorrer a uma imagem,
    ao passo que a sua esposa ainda ter\xE1 posado para o artista.\r\n\r\nMiguel
    \xC2ngelo Lupi (1826\u20131883)\r\n1873\r\n\xD3leo sobre tela\r\nOil on canvas\r\nAquisi\xE7\xE3o,
    1960\r\nAcquisition, 1960\r\n1100 Pin MNSR\r\n1101 Pin MNSR\r\n\r\n[Ingl\xEAs
    \u2014 coluna direita]\r\nPedro Paulo Ferreira de Sousa, 1st Baron of Pernes
    and a brave combatant in the Battle of Pernes in 1834, and his wife, Baroness
    Helena de \xC1gueda Bon.\r\nMiguel \xC2ngelo Lupi, who painted portraits of bourgeois
    society between 1870 and 1880, is regarded as a pioneer of realism in portraiture
    in Portugal. The artist highlights the two figures against backgrounds of graduating
    colour, giving the illusion of depth.\r\nThe couple is portrayed eleven years
    after the baron's death, meaning that the artist must have worked from an image
    to paint him, while his wife is thought to have posed for the artist."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
