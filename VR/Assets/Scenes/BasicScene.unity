      m_Calls: []
  m_text: "This series of 26 enamelled plaques was part of an altarpiece that is
    still in situ today in the Sanctuary of the Monastery of Santa Cruz in Coimbra.\r\nIt
    depicts scenes from the Cycle of the Passion of Christ, inspired by the series
    of woodcuts known as the Small Passion, by Albrecht D\xFCrer, published for the
    first time in 1511."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
