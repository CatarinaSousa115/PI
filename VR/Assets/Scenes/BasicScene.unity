  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Artistas que se destacaram em Portugal na viragem para o s\xE9culo XIX,
    com obras inovadoras de temas hist\xF3ricos da \xE9poca e da sociedade anunciando
    o Romantismo, movimento cultural vigente na Europa. Contactaram de perto com
    os mais conceituados meios art\xEDsticos europeus e foram pintores da corte do
    rei D. Jo\xE3o VI.\r\n\r\nSequeira (1768\u20131837) deixou vasta obra que ilustra
    as transforma\xE7\xF5es pol\xEDticas e sociais de in\xEDcios do s\xE9culo XIX,
    como as Invas\xF5es Francesas abordadas em Junot protegendo a cidade de Lisboa.
    A paisagem com a cena da Fuga de Margarida de Anjou de Vieira Portuense (1765\u20131805)
    reflete a exalta\xE7\xE3o de sentimentos que anuncia a \xE9poca rom\xE2ntica."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
