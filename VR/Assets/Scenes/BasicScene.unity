  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'On Mount Golgotha, the dim, mysterious, almost supernatural light isolates
    each of the groups that form the dense crowd and reveals the role that each of
    them plays in the action.

    The scene is observed from afar, like a stage
    where the actors move in silence or whispering, without tumult or manifestation
    of pain.

    Sequeira chose to represent not exactly the moment when Christ''s
    body was taken down from the cross, but the moment afterwards. Many of the characters
    already have their backs turned to the figure of Christ, and others are already
    engaged in the procedures that precede the deposition in the tomb, emphasising
    that action has already taken place and conveying the feeling that the subject
    of the painting is not death nor the end, but a passage towards Resurrection.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
